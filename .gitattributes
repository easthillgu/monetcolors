# 仓库内统一 LF，避免 Windows 上 core.autocrlf 造成的整文件 diff
* text=auto
.gitattributes text eol=lf
.gitignore     text eol=lf

# Lua / TOC / 脚本 / 文档：仓库内始终 LF
*.lua   text eol=lf
*.toc   text eol=lf
*.md    text eol=lf
*.ps1   text eol=lf
*.mjs   text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.html  text eol=lf

# 二进制素材：不做换行/编码转换
*.png   binary
*.jpg   binary
*.blp   binary
